# Copy to .env and fill in. .env is gitignored.

# The base connector key — REQUIRED. Both the generator and the jury run
# through OpenRouter with this single key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Email notifications — OPTIONAL. If unset, the harness logs notifications to
# the console instead of emailing. Implicit TLS on port 465 (SMTPS);
# STARTTLS/587 is not supported.
#SMTP_HOST=smtp.your-provider.tld
#SMTP_USER=agent@example.com
#SMTP_PASS=...
# Optional:
#SMTP_PORT=465
#SMTP_FROM=agent@example.com
